import { useState, useMemo } from 'react';
import { Plus, Trash2, FileDown, X, Users, Receipt, ArrowLeft } from 'lucide-react';

const seedClients = [
  { id: 1, name: 'Atlas Retail SARL', email: 'contact@atlasretail.ma', phone: '0522-11-22-33' },
  { id: 2, name: 'Nour Studio', email: 'hello@nourstudio.ma', phone: '0661-45-67-89' },
];

const seedInvoices = [
  {
    id: 1,
    number: 'INV-7F2A9C1D',
    clientId: 1,
    status: 'paid',
    issueDate: '2026-07-10',
    dueDate: '2026-07-20',
    items: [
      { id: 1, description: 'Website maintenance — July', qty: 1, price: 1800 },
      { id: 2, description: 'Extra revision round', qty: 2, price: 250 },
    ],
    paid: 2300,
  },
  {
    id: 2,
    number: 'INV-3B8E01F4',
    clientId: 2,
    status: 'sent',
    issueDate: '2026-07-22',
    dueDate: '2026-08-05',
    items: [{ id: 1, description: 'Brand identity package', qty: 1, price: 4200 }],
    paid: 0,
  },
];

const statusStyles = {
  draft: 'bg-stone-100 text-stone-600 border-stone-200',
  sent: 'bg-amber-50 text-amber-700 border-amber-200',
  paid: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  overdue: 'bg-rose-50 text-rose-700 border-rose-200',
};

function money(n) {
  return new Intl.NumberFormat('fr-MA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n) + ' MAD';
}

export default function App() {
  const [clients, setClients] = useState(seedClients);
  const [invoices, setInvoices] = useState(seedInvoices);
  const [view, setView] = useState('invoices'); // invoices | clients | new-invoice | invoice-detail
  const [activeInvoiceId, setActiveInvoiceId] = useState(null);
  const [clientForm, setClientForm] = useState({ name: '', email: '', phone: '' });

  const clientMap = useMemo(() => Object.fromEntries(clients.map((c) => [c.id, c])), [clients]);

  const invoiceTotal = (inv) => inv.items.reduce((s, i) => s + i.qty * i.price, 0);
  const balanceDue = (inv) => invoiceTotal(inv) - inv.paid;

  const addClient = (e) => {
    e.preventDefault();
    if (!clientForm.name.trim()) return;
    setClients([...clients, { id: Date.now(), ...clientForm }]);
    setClientForm({ name: '', email: '', phone: '' });
  };

  const activeInvoice = invoices.find((i) => i.id === activeInvoiceId);

  return (
    <div className="min-h-screen bg-stone-50 text-stone-900">
      {/* Sidebar */}
      <div className="flex">
        <aside className="w-56 min-h-screen bg-stone-900 text-stone-200 flex flex-col shrink-0">
          <div className="px-5 py-5 border-b border-white/10">
            <p className="font-mono text-sm tracking-wide text-emerald-400">LEDGR</p>
            <p className="text-xs text-stone-400 mt-0.5">Invoice & clients</p>
          </div>
          <nav className="flex-1 px-3 py-4 space-y-1">
            <button
              onClick={() => setView('invoices')}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition ${view.startsWith('invoice') ? 'bg-white/10 text-white' : 'text-stone-400 hover:bg-white/5'}`}
            >
              <Receipt size={16} /> Invoices
            </button>
            <button
              onClick={() => setView('clients')}
              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-md text-sm transition ${view === 'clients' ? 'bg-white/10 text-white' : 'text-stone-400 hover:bg-white/5'}`}
            >
              <Users size={16} /> Clients
            </button>
          </nav>
          <div className="px-5 py-4 text-xs text-stone-500 border-t border-white/10">
            demo preview — in-memory data
          </div>
        </aside>

        {/* Main content */}
        <main className="flex-1 p-8 max-w-4xl">
          {view === 'invoices' && (
            <InvoiceList
              invoices={invoices}
              clientMap={clientMap}
              invoiceTotal={invoiceTotal}
              onNew={() => setView('new-invoice')}
              onOpen={(id) => { setActiveInvoiceId(id); setView('invoice-detail'); }}
            />
          )}

          {view === 'clients' && (
            <ClientsView clients={clients} form={clientForm} setForm={setClientForm} onAdd={addClient} />
          )}

          {view === 'new-invoice' && (
            <NewInvoiceForm
              clients={clients}
              onCancel={() => setView('invoices')}
              onCreate={(inv) => {
                setInvoices([{ ...inv, id: Date.now(), number: 'INV-' + Math.random().toString(16).slice(2, 10).toUpperCase(), status: 'draft', paid: 0 }, ...invoices]);
                setView('invoices');
              }}
            />
          )}

          {view === 'invoice-detail' && activeInvoice && (
            <InvoiceDetail
              invoice={activeInvoice}
              client={clientMap[activeInvoice.clientId]}
              total={invoiceTotal(activeInvoice)}
              balance={balanceDue(activeInvoice)}
              onBack={() => setView('invoices')}
              onMarkSent={() => setInvoices(invoices.map((i) => i.id === activeInvoice.id ? { ...i, status: 'sent' } : i))}
              onRecordPayment={(amount) => {
                setInvoices(invoices.map((i) => {
                  if (i.id !== activeInvoice.id) return i;
                  const newPaid = i.paid + amount;
                  const newStatus = newPaid >= invoiceTotal(i) ? 'paid' : i.status;
                  return { ...i, paid: newPaid, status: newStatus };
                }));
              }}
            />
          )}
        </main>
      </div>
    </div>
  );
}

function InvoiceList({ invoices, clientMap, invoiceTotal, onNew, onOpen }) {
  return (
    <div>
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-xl font-semibold">Invoices</h1>
          <p className="text-sm text-stone-500 mt-0.5">{invoices.length} total</p>
        </div>
        <button
          onClick={onNew}
          className="flex items-center gap-1.5 bg-stone-900 text-white text-sm px-4 py-2 rounded-md hover:bg-stone-800 transition"
        >
          <Plus size={16} /> New invoice
        </button>
      </div>

      <div className="bg-white rounded-lg border border-stone-200 overflow-hidden">
        <table className="w-full text-sm">
          <thead>
            <tr className="text-left text-stone-500 border-b border-stone-200 bg-stone-50">
              <th className="px-4 py-3 font-medium">Number</th>
              <th className="px-4 py-3 font-medium">Client</th>
              <th className="px-4 py-3 font-medium">Due</th>
              <th className="px-4 py-3 font-medium text-right">Total</th>
              <th className="px-4 py-3 font-medium">Status</th>
            </tr>
          </thead>
          <tbody>
            {invoices.map((inv) => (
              <tr
                key={inv.id}
                onClick={() => onOpen(inv.id)}
                className="border-b border-stone-100 last:border-0 hover:bg-stone-50 cursor-pointer transition"
              >
                <td className="px-4 py-3 font-mono text-xs">{inv.number}</td>
                <td className="px-4 py-3">{clientMap[inv.clientId]?.name}</td>
                <td className="px-4 py-3 text-stone-500">{inv.dueDate}</td>
                <td className="px-4 py-3 text-right font-mono">{money(invoiceTotal(inv))}</td>
                <td className="px-4 py-3">
                  <span className={`text-xs px-2 py-1 rounded border capitalize ${statusStyles[inv.status]}`}>
                    {inv.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

function ClientsView({ clients, form, setForm, onAdd }) {
  return (
    <div>
      <h1 className="text-xl font-semibold mb-6">Clients</h1>

      <form onSubmit={onAdd} className="bg-white rounded-lg border border-stone-200 p-4 mb-6 grid grid-cols-3 gap-3">
        <input
          className="border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-stone-300"
          placeholder="Name"
          value={form.name}
          onChange={(e) => setForm({ ...form, name: e.target.value })}
        />
        <input
          className="border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-stone-300"
          placeholder="Email"
          value={form.email}
          onChange={(e) => setForm({ ...form, email: e.target.value })}
        />
        <div className="flex gap-2">
          <input
            className="border border-stone-200 rounded-md px-3 py-2 text-sm flex-1 focus:outline-none focus:ring-2 focus:ring-stone-300"
            placeholder="Phone"
            value={form.phone}
            onChange={(e) => setForm({ ...form, phone: e.target.value })}
          />
          <button className="bg-stone-900 text-white px-3 rounded-md hover:bg-stone-800">
            <Plus size={16} />
          </button>
        </div>
      </form>

      <div className="bg-white rounded-lg border border-stone-200 divide-y divide-stone-100">
        {clients.map((c) => (
          <div key={c.id} className="px-4 py-3 flex justify-between items-center">
            <div>
              <p className="font-medium text-sm">{c.name}</p>
              <p className="text-xs text-stone-500 mt-0.5">{c.email} · {c.phone}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function NewInvoiceForm({ clients, onCancel, onCreate }) {
  const [clientId, setClientId] = useState(clients[0]?.id || '');
  const [issueDate, setIssueDate] = useState(new Date().toISOString().slice(0, 10));
  const [dueDate, setDueDate] = useState('');
  const [items, setItems] = useState([{ id: 1, description: '', qty: 1, price: 0 }]);

  const total = items.reduce((s, i) => s + i.qty * i.price, 0);

  const updateItem = (id, field, value) => {
    setItems(items.map((it) => it.id === id ? { ...it, [field]: value } : it));
  };
  const addItem = () => setItems([...items, { id: Date.now(), description: '', qty: 1, price: 0 }]);
  const removeItem = (id) => setItems(items.filter((it) => it.id !== id));

  return (
    <div>
      <div className="flex items-center gap-2 mb-6">
        <button onClick={onCancel} className="text-stone-400 hover:text-stone-700"><ArrowLeft size={18} /></button>
        <h1 className="text-xl font-semibold">New invoice</h1>
      </div>

      <div className="bg-white rounded-lg border border-stone-200 p-5 space-y-4">
        <div className="grid grid-cols-3 gap-3">
          <select
            className="border border-stone-200 rounded-md px-3 py-2 text-sm"
            value={clientId}
            onChange={(e) => setClientId(Number(e.target.value))}
          >
            {clients.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
          <input type="date" className="border border-stone-200 rounded-md px-3 py-2 text-sm" value={issueDate} onChange={(e) => setIssueDate(e.target.value)} />
          <input type="date" className="border border-stone-200 rounded-md px-3 py-2 text-sm" value={dueDate} onChange={(e) => setDueDate(e.target.value)} placeholder="Due date" />
        </div>

        <div className="space-y-2">
          {items.map((it) => (
            <div key={it.id} className="grid grid-cols-12 gap-2 items-center">
              <input
                className="col-span-6 border border-stone-200 rounded-md px-2 py-1.5 text-sm"
                placeholder="Description"
                value={it.description}
                onChange={(e) => updateItem(it.id, 'description', e.target.value)}
              />
              <input
                type="number" min="1"
                className="col-span-2 border border-stone-200 rounded-md px-2 py-1.5 text-sm"
                value={it.qty}
                onChange={(e) => updateItem(it.id, 'qty', Number(e.target.value))}
              />
              <input
                type="number" min="0" step="0.01"
                className="col-span-3 border border-stone-200 rounded-md px-2 py-1.5 text-sm"
                value={it.price}
                onChange={(e) => updateItem(it.id, 'price', Number(e.target.value))}
              />
              <button onClick={() => removeItem(it.id)} className="col-span-1 text-stone-400 hover:text-rose-600">
                <Trash2 size={15} />
              </button>
            </div>
          ))}
          <button onClick={addItem} className="text-sm text-stone-600 hover:text-stone-900 flex items-center gap-1">
            <Plus size={14} /> Add item
          </button>
        </div>

        <div className="flex justify-between items-center pt-3 border-t border-stone-100">
          <p className="font-mono font-semibold">{money(total)}</p>
          <button
            onClick={() => onCreate({ clientId, issueDate, dueDate, items: items.map((i) => ({ ...i })) })}
            className="bg-stone-900 text-white text-sm px-4 py-2 rounded-md hover:bg-stone-800"
          >
            Create invoice
          </button>
        </div>
      </div>
    </div>
  );
}

function InvoiceDetail({ invoice, client, total, balance, onBack, onMarkSent, onRecordPayment }) {
  const [showPayment, setShowPayment] = useState(false);
  const [amount, setAmount] = useState(balance);

  return (
    <div>
      <div className="flex items-center gap-2 mb-6">
        <button onClick={onBack} className="text-stone-400 hover:text-stone-700"><ArrowLeft size={18} /></button>
        <h1 className="text-xl font-semibold font-mono">{invoice.number}</h1>
        <span className={`text-xs px-2 py-1 rounded border capitalize ${statusStyles[invoice.status]}`}>{invoice.status}</span>
      </div>

      <div className="bg-white rounded-lg border border-stone-200 p-6">
        <div className="flex justify-between mb-6">
          <div>
            <p className="text-xs text-stone-400 uppercase tracking-wide">Bill to</p>
            <p className="font-medium mt-1">{client?.name}</p>
            <p className="text-sm text-stone-500">{client?.email}</p>
          </div>
          <div className="text-right">
            <p className="text-xs text-stone-400 uppercase tracking-wide">Due date</p>
            <p className="font-medium mt-1">{invoice.dueDate}</p>
          </div>
        </div>

        <table className="w-full text-sm mb-4">
          <thead>
            <tr className="text-left text-stone-400 border-b border-stone-100">
              <th className="pb-2 font-medium">Description</th>
              <th className="pb-2 font-medium text-right">Qty</th>
              <th className="pb-2 font-medium text-right">Price</th>
              <th className="pb-2 font-medium text-right">Subtotal</th>
            </tr>
          </thead>
          <tbody>
            {invoice.items.map((it) => (
              <tr key={it.id} className="border-b border-stone-50">
                <td className="py-2">{it.description}</td>
                <td className="py-2 text-right">{it.qty}</td>
                <td className="py-2 text-right font-mono">{money(it.price)}</td>
                <td className="py-2 text-right font-mono">{money(it.qty * it.price)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div className="flex justify-end">
          <div className="w-56 space-y-1 text-sm">
            <div className="flex justify-between"><span className="text-stone-500">Total</span><span className="font-mono">{money(total)}</span></div>
            <div className="flex justify-between"><span className="text-stone-500">Paid</span><span className="font-mono">{money(invoice.paid)}</span></div>
            <div className="flex justify-between font-semibold pt-1 border-t border-stone-100"><span>Balance due</span><span className="font-mono">{money(balance)}</span></div>
          </div>
        </div>

        <div className="flex gap-2 mt-6 pt-4 border-t border-stone-100">
          {invoice.status === 'draft' && (
            <button onClick={onMarkSent} className="text-sm px-3 py-1.5 rounded-md border border-stone-200 hover:bg-stone-50">Mark as sent</button>
          )}
          {balance > 0 && (
            <button onClick={() => setShowPayment(true)} className="text-sm px-3 py-1.5 rounded-md border border-stone-200 hover:bg-stone-50">Record payment</button>
          )}
          <button className="flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-md bg-stone-900 text-white hover:bg-stone-800 ml-auto">
            <FileDown size={14} /> Download PDF
          </button>
        </div>
      </div>

      {showPayment && (
        <div className="fixed inset-0 bg-black/30 flex items-center justify-center" onClick={() => setShowPayment(false)}>
          <div className="bg-white rounded-lg p-5 w-80" onClick={(e) => e.stopPropagation()}>
            <div className="flex justify-between items-center mb-3">
              <p className="font-medium text-sm">Record payment</p>
              <button onClick={() => setShowPayment(false)}><X size={16} className="text-stone-400" /></button>
            </div>
            <input
              type="number"
              className="border border-stone-200 rounded-md px-3 py-2 text-sm w-full mb-3"
              value={amount}
              onChange={(e) => setAmount(Number(e.target.value))}
            />
            <button
              onClick={() => { onRecordPayment(amount); setShowPayment(false); }}
              className="bg-stone-900 text-white text-sm w-full py-2 rounded-md hover:bg-stone-800"
            >
              Confirm payment
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
